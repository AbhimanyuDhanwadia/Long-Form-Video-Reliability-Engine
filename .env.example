# Environment Configuration Example
# Copy this file to .env and fill in your API keys

# Mock mode toggle (true = use mock generation, false = use real APIs)
USE_MOCK=true

# API Keys
FLUX_API_KEY=your_flux_api_key_here
RUNWAY_API_KEY=your_runway_api_key_here

# API Endpoints (optional, defaults provided)
# FLUX_API_URL=https://api.bfl.ml/v1/generate
# RUNWAY_API_URL=https://api.runwayml.com/v1/generate

# Retry settings (optional)
# MAX_RETRIES=3
# CRITIC_PASS_RATE=0.7
